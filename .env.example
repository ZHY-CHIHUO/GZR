# 《蛊真人》RAG 配置
# ⭐ 最省事的方式：打开网页后去「设置」页，按教程填入 API Key，会自动写入本文件。
# 也可手动编辑本文件后重启服务。

# OpenAI 兼容服务（留空 Key = 检索测试模式，只有检索结果、没有 AI 回答）
# 下面默认使用 DeepSeek，也可换成 OpenAI、硅基流动、火山方舟或本地 Ollama。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 兼容旧版本变量：AI_* 未设置时仍会读取 DEEPSEEK_API_KEY / BASE_URL / MODEL。

# 检索参数
RAG_TOP_K=5
RAG_EXCERPT_CHARS=600

# 数据/模型路径（默认相对项目根目录）
RAG_DATA_DIR=data_jina2
RAG_MODEL_CACHE_DIR=model_cache
