# 《蛊真人》RAG 配置
# ⭐ 最省事的方式：打开网页后去「设置」页，按教程填入 API Key，会自动写入本文件。
# 也可手动编辑本文件后重启服务。

# DeepSeek API Key（留空 = 检索测试模式，只有检索结果、没有 AI 回答）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 检索参数
RAG_TOP_K=5
RAG_EXCERPT_CHARS=600

# 数据/模型路径（默认相对项目根目录）
RAG_DATA_DIR=data
RAG_MODEL_CACHE_DIR=model_cache
